{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "martynbiz26/work-item",
	"version": "1.0.0",
	"title": "Work item",
	"category": "theme",
	"icon": "building",
	"description": "A place you've worked: company name, optional subtitle and period, and a description. Stack several to form a timeline.",
	"keywords": [ "work", "job", "company", "experience", "timeline" ],
	"textdomain": "martynbiz26",
	"attributes": {
		"company": {
			"type": "string",
			"default": ""
		},
		"subtitle": {
			"type": "string",
			"default": ""
		},
		"period": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"spacing": {
			"margin": true
		}
	},
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
